# Copier ce fichier en `.env` puis renseigner les valeurs.
# `.env` est ignoré par git (voir .gitignore).

# Token du bot Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=

# Clé API Mistral (https://console.mistral.ai/)
MISTRAL_API_KEY=

# Optionnel : IDs des salons « sans historique », séparés par des virgules
# NO_HISTORY_CHANNEL_IDS=123456789012345678,987654321098765432
